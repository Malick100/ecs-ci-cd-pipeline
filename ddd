            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text);
            line-height: 1.45;
            background-color: #f1f5f9;
            padding: 20px;
        }

        .resume-container {
            max-width: 850px;
            margin: 0 auto;
            background: #ffffff;
            padding: 35px 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border-radius: 4px;
        }

        /* Header */
        header {
            border-bottom: 2px solid var(--primary);
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        h1 {
            font-size: 24px;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .subtitle {
            font-size: 14px;
            font-weight: 600;
            color: var(--accent);
            margin-top: 2px;
            margin-bottom: 8px;
        }

        .contact-info {
            display: flex;
            flex-wrap: wrap;
            gap: 12px 18px;
            font-size: 12px;
            color: #475569;
        }

        .contact-info span {
            display: flex;
            align-items: center;
        }

        /* Layout Grid */
        .content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
        }

        /* Section Headings */
        h2 {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--primary);
            border-bottom: 1.5px solid var(--border);
            padding-bottom: 3px;
            margin-bottom: 10px;
        }

        section {
            margin-bottom: 16px;
        }

        /* Summary */
        .summary p {
            font-size: 12px;
            color: #475569;
        }

        /* Experience */
        .job {
            margin-bottom: 12px;
        }

        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 2px;
        }

        .job-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--primary);
        }

        .company {
            font-size: 12px;
            font-weight: 600;
            color: var(--accent);
        }

        .date {
            font-size: 11px;
            color: #64748b;
            font-weight: 500;
        }

        ul {
            list-style-type: disc;
            margin-left: 16px;
            font-size: 11.5px;
        }

        li {
            margin-bottom: 3px;
            color: #334155;
        }

        /* Skills Sidebar */
        .skill-group {
            margin-bottom: 10px;
        }

        .skill-title {
            font-size: 11px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 3px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .tag {
            background-color: var(--light-bg);
            border: 1px solid var(--border);
            color: #334155;
            font-size: 10.5px;
            padding: 2px 6px;
            border-radius: 3px;
            font-weight: 500;
        }

        /* Education & Certs */
        .item-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--primary);
        }

        .item-sub {
            font-size: 11px;
            color: #64748b;
        }

        /* Print Styles for Single Page Fit */
        @media print {
            body {
                background: none;
                padding: 0;
            }
            .resume-container {
                box-shadow: none;
                padding: 0;
                width: 100%;
                max-width: 100%;
            }
            @page {
                size: A4 portrait;
                margin: 0.4in;
            }
        }
    </style>
</head>
